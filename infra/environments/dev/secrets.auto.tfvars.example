# Copy to secrets.auto.tfvars and fill in. OpenTofu loads *.auto.tfvars by
# itself; the file is gitignored and only this example is committed. The
# non-secret settings are in dev.tfvars. Never put the Cloudflare API token
# here: it is read from the CLOUDFLARE_API_TOKEN environment variable.

# The Access invite list for dev: personal data, so it stays out of git.
allowed_emails = ["you@example.com"]

# openssl rand -hex 32
origin_secret = "<64-hex-characters>"

# The family devices page at /admin (ADR 0010): who may open it, the two
# adults, and the three values from the Zero Trust root's outputs
# (infra/zero-trust: kids_doh_url, adults_doh_url, gateway_root_ca_pem).
# Personal data and values that change with that root, so they stay out of
# git. Leave them out until the root has been applied: empty means the page
# says the profiles are not configured yet.
admin_emails = ["you@example.com", "them@example.com"]
# kids_doh_url        = "https://<subdomain>.cloudflare-gateway.com/dns-query"
# adults_doh_url      = "https://<subdomain>.cloudflare-gateway.com/dns-query"
# gateway_root_ca_pem = <<-PEM
#   -----BEGIN CERTIFICATE-----
#   ...
#   -----END CERTIFICATE-----
# PEM
